{
  "name": "Aircraft",
  "type": "object",
  "properties": {
    "registration": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "time_source": {
      "type": "string",
      "enum": [
        "Hobbs",
        "Tach",
        "Manual"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "SEP",
        "MEP",
        "Helicopter",
        "Drone (RPAS)",
        "Other"
      ]
    },
    "pic_time": {
      "type": "number",
      "default": 0
    },
    "dual_time": {
      "type": "number",
      "default": 0
    },
    "total_time": {
      "type": "number",
      "default": 0
    },
    "last_flown": {
      "type": "string",
      "format": "date"
    },
    "current_reading": {
      "type": "number",
      "default": 0
    },
    "engine_hours": {
      "type": "number",
      "default": 0
    },
    "mpi_due_reading": {
      "type": "number"
    },
    "oil_due_reading": {
      "type": "number"
    },
    "serial_number": {
      "type": "string"
    },
    "weight_class": {
      "type": "string",
      "enum": [
        "< 250 g",
        "250 g \u2013 2 kg",
        "2 \u2013 7 kg",
        "7 \u2013 25 kg",
        "> 25 kg",
        "Manned"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "registration",
    "type"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}