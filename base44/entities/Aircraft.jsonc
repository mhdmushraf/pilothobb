{
  "name": "Aircraft",
  "properties": {
    "airframe_hours": {
      "description": "Total airframe hours",
      "type": "number"
    },
    "category": {
      "enum": [
        "SEP",
        "MEP",
        "Helicopter",
        "Drone (RPAS)",
        "Other"
      ],
      "type": "string"
    },
    "current_reading": {
      "default": 0,
      "type": "number"
    },
    "description": {
      "maxLength": 1000,
      "type": "string"
    },
    "dual_time": {
      "default": 0,
      "type": "number"
    },
    "engine_hours": {
      "default": 0,
      "type": "number"
    },
    "hobbs_reading": {
      "description": "Latest Hobbs meter reading",
      "type": "number"
    },
    "last_flown": {
      "format": "date",
      "type": "string"
    },
    "mpi_due_reading": {
      "type": "number"
    },
    "oil_due_reading": {
      "type": "number"
    },
    "pic_time": {
      "default": 0,
      "type": "number"
    },
    "propeller_hours": {
      "description": "Propeller hours since new or overhaul",
      "type": "number"
    },
    "registration": {
      "type": "string"
    },
    "serial_number": {
      "type": "string"
    },
    "tach_reading": {
      "description": "Latest Tach meter reading",
      "type": "number"
    },
    "time_multiplier": {
      "default": 1,
      "description": "Flight time = meter difference x this multiplier (for example 1.2 for Tach-based logging)",
      "type": "number"
    },
    "time_source": {
      "enum": [
        "Hobbs",
        "Tach",
        "Manual"
      ],
      "type": "string"
    },
    "total_time": {
      "default": 0,
      "type": "number"
    },
    "type": {
      "type": "string"
    },
    "weight_class": {
      "enum": [
        "< 250 g",
        "250 g \u2013 2 kg",
        "2 \u2013 7 kg",
        "7 \u2013 25 kg",
        "> 25 kg",
        "Manned"
      ],
      "type": "string"
    }
  },
  "required": [
    "registration",
    "type"
  ],
  "type": "object",
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}