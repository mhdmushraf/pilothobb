{
  "name": "Licence",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Licence",
        "Rating",
        "Medical",
        "Operator Approval"
      ]
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "framework": {
      "type": "string",
      "enum": [
        "SACAA",
        "FAA",
        "EASA",
        "UK CAA",
        "CASA",
        "Other"
      ]
    },
    "discipline": {
      "type": "string",
      "enum": [
        "Manned",
        "RPAS"
      ],
      "default": "Manned"
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}