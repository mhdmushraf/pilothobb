{
  "name": "FlightPlan",
  "properties": {
    "booking": {
      "description": "id of the linked Booking record, if this plan has been scheduled",
      "type": "string"
    },
    "cruise_speed": {
      "type": "number"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "distance_nm": {
      "type": "number"
    },
    "from_aerodrome": {
      "type": "string"
    },
    "fuel_burn_rate": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "reserve_min": {
      "default": 45,
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "to_aerodrome": {
      "type": "string"
    },
    "waypoints": {
      "description": "JSON array of {code,name,lat,lon,alt_ft} in route order, stored as a JSON string",
      "type": "string"
    },
    "wind_dir": {
      "type": "number"
    },
    "wind_speed": {
      "type": "number"
    }
  },
  "required": [
    "title"
  ],
  "type": "object",
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}