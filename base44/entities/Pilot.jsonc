{
  "name": "Pilot",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "authority": {
      "type": "string",
      "enum": [
        "FAA",
        "EASA",
        "UK CAA",
        "SACAA",
        "CASA",
        "Other"
      ]
    },
    "licence_type": {
      "type": "string",
      "enum": [
        "Student",
        "PPL",
        "CPL",
        "ATPL",
        "RPL"
      ]
    },
    "english_level": {
      "type": "number"
    },
    "english_valid_until": {
      "type": "string",
      "format": "date"
    },
    "home_aerodrome": {
      "type": "string"
    },
    "total_time": {
      "type": "number",
      "default": 0
    },
    "total_pic": {
      "type": "number",
      "default": 0
    },
    "total_dual": {
      "type": "number",
      "default": 0
    },
    "total_xc": {
      "type": "number",
      "default": 0
    },
    "total_night": {
      "type": "number",
      "default": 0
    },
    "total_instrument": {
      "type": "number",
      "default": 0
    },
    "total_landings": {
      "type": "number",
      "default": 0
    },
    "total_takeoffs": {
      "type": "number",
      "default": 0
    },
    "total_picus": {
      "type": "number",
      "default": 0
    },
    "total_co_pilot": {
      "type": "number",
      "default": 0
    },
    "rpas_total_time": {
      "type": "number",
      "default": 0
    },
    "rpas_launches": {
      "type": "number",
      "default": 0
    },
    "rpas_landings": {
      "type": "number",
      "default": 0
    },
    "rpas_night_time": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}