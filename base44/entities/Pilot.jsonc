{
  "name": "Pilot",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "authority": {
      "type": "string",
      "enum": [
        "FAA",
        "EASA",
        "UK CAA",
        "SACAA",
        "CASA",
        "Other"
      ]
    },
    "licence_type": {
      "type": "string",
      "enum": [
        "Student",
        "PPL",
        "CPL",
        "ATPL",
        "RPL"
      ]
    },
    "english_level": {
      "type": "number"
    },
    "english_valid_until": {
      "type": "string",
      "format": "date"
    },
    "home_aerodrome": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "total_time": {
      "type": "number",
      "default": 0
    },
    "total_pic": {
      "type": "number",
      "default": 0
    },
    "total_dual": {
      "type": "number",
      "default": 0
    },
    "total_xc": {
      "type": "number",
      "default": 0
    },
    "total_night": {
      "type": "number",
      "default": 0
    },
    "total_instrument": {
      "type": "number",
      "default": 0
    },
    "total_landings": {
      "type": "number",
      "default": 0
    },
    "total_takeoffs": {
      "type": "number",
      "default": 0
    },
    "total_picus": {
      "type": "number",
      "default": 0
    },
    "total_co_pilot": {
      "type": "number",
      "default": 0
    },
    "rpas_total_time": {
      "type": "number",
      "default": 0
    },
    "rpas_launches": {
      "type": "number",
      "default": 0
    },
    "rpas_landings": {
      "type": "number",
      "default": 0
    },
    "rpas_night_time": {
      "type": "number",
      "default": 0
    },
    "onboarded": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "cpl",
        "school"
      ],
      "default": "free"
    },
    "plan_valid_until": {
      "type": "string",
      "format": "date"
    },
    "plan_source": {
      "type": "string",
      "enum": [
        "tap",
        "stripe",
        "bank_transfer",
        "admin"
      ]
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "none",
        "trialing",
        "active",
        "past_due",
        "canceling",
        "canceled"
      ],
      "default": "none"
    },
    "trial_ends_at": {
      "type": "string"
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}