{
  "name": "Exam",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string",
      "enum": [
        "PPL",
        "CPL",
        "IR",
        "Restricted Radio",
        "General Radio",
        "Night Rating",
        "ATPL",
        "RPL",
        "Other"
      ]
    },
    "date_written": {
      "type": "string",
      "format": "date"
    },
    "marks": {
      "type": "number"
    },
    "passed": {
      "type": "boolean"
    },
    "valid_18_months": {
      "type": "string",
      "format": "date"
    },
    "valid_36_months": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "subject",
    "date_written"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}