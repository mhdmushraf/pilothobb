{
  "name": "Booking",
  "type": "object",
  "properties": {
    "aircraft": {
      "type": "string",
      "relationType": "reference",
      "referenceEntity": "Aircraft"
    },
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "Training",
        "Private",
        "Checkride",
        "Maintenance",
        "Cross-country",
        "Other"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "aircraft",
    "date",
    "start_time"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}