{
  "name": "Booking",
  "properties": {
    "aircraft": {
      "referenceEntity": "Aircraft",
      "relationType": "reference",
      "type": "string"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "flight_plan": {
      "description": "id of the linked FlightPlan record, if this booking has a planned route",
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "purpose": {
      "enum": [
        "Training",
        "Private",
        "Checkride",
        "Maintenance",
        "Cross-country",
        "Other"
      ],
      "type": "string"
    },
    "start_time": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "aircraft",
    "date",
    "start_time"
  ],
  "type": "object",
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}