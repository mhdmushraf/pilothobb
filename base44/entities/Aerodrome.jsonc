{
  "name": "Aerodrome",
  "type": "object",
  "properties": {
    "icao": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "elevation": {
      "type": "number"
    },
    "runways": {
      "type": "string"
    },
    "frequency": {
      "type": "string"
    },
    "landing_fee": {
      "type": "string"
    },
    "contact": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "icao"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}