{
  "name": "Flight",
  "properties": {
    "aircraft": {
      "referenceEntity": "Aircraft",
      "relationType": "reference",
      "type": "string"
    },
    "autorotations": {
      "default": 0,
      "type": "number"
    },
    "battery_cycles": {
      "default": 0,
      "type": "number"
    },
    "co_pilot_time": {
      "default": 0,
      "type": "number"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "dual_time": {
      "default": 0,
      "type": "number"
    },
    "flight_time": {
      "type": "number"
    },
    "from_aerodrome": {
      "type": "string"
    },
    "hoist_cycles": {
      "default": 0,
      "type": "number"
    },
    "instrument_actual": {
      "default": 0,
      "type": "number"
    },
    "instrument_sim": {
      "default": 0,
      "type": "number"
    },
    "is_rpas": {
      "default": false,
      "type": "boolean"
    },
    "landings": {
      "type": "number"
    },
    "mission_type": {
      "enum": [
        "Training",
        "Commercial",
        "Recreational",
        "Survey/Mapping",
        "Inspection",
        "Photography/Film",
        "Agriculture",
        "Other"
      ],
      "type": "string"
    },
    "night_landings": {
      "default": 0,
      "type": "number"
    },
    "night_takeoffs": {
      "default": 0,
      "type": "number"
    },
    "night_time": {
      "default": 0,
      "type": "number"
    },
    "observer": {
      "type": "string"
    },
    "operation_category": {
      "enum": [
        "VLOS",
        "EVLOS",
        "BVLOS"
      ],
      "type": "string"
    },
    "pic_time": {
      "default": 0,
      "type": "number"
    },
    "picus_time": {
      "default": 0,
      "type": "number"
    },
    "pilot_role": {
      "enum": [
        "PIC",
        "Dual",
        "PICUS",
        "Co-pilot"
      ],
      "type": "string"
    },
    "reading_after": {
      "type": "number"
    },
    "reading_before": {
      "type": "number"
    },
    "remarks": {
      "type": "string"
    },
    "route": {
      "type": "string"
    },
    "sim_time": {
      "default": 0,
      "type": "number"
    },
    "takeoffs": {
      "type": "number"
    },
    "to_aerodrome": {
      "type": "string"
    },
    "touch_and_go": {
      "default": 0,
      "type": "number"
    },
    "track": {
      "description": "id of the linked Track record (GPS flight recording), if this flight was auto-logged",
      "type": "string"
    },
    "xc_time": {
      "default": 0,
      "type": "number"
    }
  },
  "required": [
    "date",
    "aircraft",
    "from_aerodrome",
    "to_aerodrome",
    "flight_time"
  ],
  "type": "object",
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}